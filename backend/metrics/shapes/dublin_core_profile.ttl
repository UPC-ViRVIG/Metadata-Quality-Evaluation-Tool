@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dc:      <http://purl.org/dc/elements/1.1/> .
@prefix ex:      <http://example.org/shapes/> .


ex:DublinCoreShape
    a sh:NodeShape ;

    # Apply to everything that has an rdf:type
    sh:targetSubjectsOf rdf:type ;


    sh:property [
        sh:path dc:title ;
        sh:minCount 1 ;
        sh:message "Missing dc:title" ;
        sh:severity sh:Violation ;
    ] ;


    sh:property [
        sh:path dc:creator ;
        sh:minCount 1 ;
        sh:message "Missing dc:creator" ;
        sh:severity sh:Warning ;
    ] ;


    sh:property [
        sh:path dc:date ;
        sh:minCount 1 ;
        sh:message "Missing dc:date" ;
        sh:severity sh:Warning ;
    ] ;


    sh:property [
        sh:path dc:type ;
        sh:minCount 1 ;
        sh:message "Missing dc:type" ;
        sh:severity sh:Warning ;
    ] ;


    sh:property [
        sh:path dc:identifier ;
        sh:minCount 1 ;
        sh:message "Missing dc:identifier" ;
        sh:severity sh:Violation ;
    ] .