    <cidoc:p102_has_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string"><![CDATA[Inv. Testamentaría Carlos II, El Pardo, 1701-1703]]></cidoc:p102_has_title>
    <ecidoc:p3_has_note_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string"><![CDATA[Sala donde se abre para su Magestad [...] [61] Ottro lienzo Grande de San Jorge mattando la serpientte Con Santta Margaritta a lado de un disçipulo de rubenes con marco negro tassado en trescienttos doblones que Ualen......18.000 Existe en la Pieza 29ª a los numeros 34 y 223.]]></ecidoc:p3_has_note_id>
    <cidoc:p4_has_time-span rdf:datatype="http://www.w3.org/2001/XMLSchema#date">17010000000000</cidoc:p4_has_time-span>
