    <ecidoc:p3_has_note_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string"><![CDATA[Rubens. / 1442. San Jorge. / Acomete a caballo al dragón, y libra a la doncella, la cual tiene asido con la mano izquierda un cordero. / Alto 10 pies, 11 pulg; ancho 9 pies, 2 pulg.]]></ecidoc:p3_has_note_id>
